data/cache/*
data/copernicus/*
data/geojson/*
data/mock/*
!data/**/.gitkeep
*.nc
*.zarr/
*.geojson
*.sqlite
*.db

# ChromaDB local persistence
chroma/
.chroma/

# ── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
