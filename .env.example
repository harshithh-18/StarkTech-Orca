# ORCA environment template.
# Copy to `.env` and fill in. NEVER commit the filled-in `.env`.
#   cp .env.example .env

# ── LLM ───────────────────────────────────────────────────────────────────
# Gemini 2.x Flash — free tier. Register: https://ai.google.dev/  → "Get API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq (Llama) — fast fallback when Gemini rate-limits. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Multilingual (Bhashini — Govt of India national language stack) ───────
# Register: https://bhashini.gov.in/ulca  → create a user, then a pipeline.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Sarvam AI — fallback for ASR/TTS. https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# ── Copernicus Marine (gridded SST + chlorophyll NetCDF) ──────────────────
# Free account: https://data.marine.copernicus.eu/register
# Used by scripts/fetch_copernicus_subset.py — NOT called live at request time.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ── ORCA runtime ──────────────────────────────────────────────────────────
# Cache TTL for adapter responses. PFZ advisories are daily → 86400 is sane.
ORCA_CACHE_TTL_SECONDS=3600

# Demo safety switch: `true` serves canned responses from data/mock/ instead of
# hitting live APIs. Set this ON for the live demo (see docs/DEMO_SCRIPT.md).
ORCA_USE_MOCK_DATA=false

ORCA_LOG_LEVEL=INFO
ORCA_CORS_ORIGINS=http://localhost:5173
